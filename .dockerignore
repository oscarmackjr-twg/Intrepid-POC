# Exclude large data directories and generated files from Docker build context
backend/data/
backend/.pytest_cache/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo

# Frontend build artifacts and dependencies
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Planning and docs
.planning/
docs/
deploy/aws/
deploy/terraform/

# Git and IDE
.git/
.gitignore
*.md

# Secrets and local config
backend/.env
.env
**/.env.local

# Test outputs and temporary files
backend/data/
**/temp_*.py
backend/cd
frontend/cd
